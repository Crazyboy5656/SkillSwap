# SkillSwap V2 — Environment Variables
# Copy this file to .env and fill in your Supabase project values.
# These are injected into the HTML pages by your build/deploy tool
# (Netlify/Vercel environment variables → window.SUPABASE_URL etc.)

SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
